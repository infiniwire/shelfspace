{
  "name": "shelfspace",
  "version": "1.0.0",
  "description": "A personal library and lending tracker for sharing books, films, and games with friends. Node/Express + MongoDB backend.",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node ./bin/www",
    "dev": "node --watch ./bin/www",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "build": "npm install --prefix frontend && npm run build --prefix frontend"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thejuu5/shelfspace.git"
  },
  "keywords": [
    "library",
    "lending",
    "express",
    "mongodb",
    "react"
  ],
  "author": "Thejaswini Srinivasan, Tor Ekstrom",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thejuu5/shelfspace/issues"
  },
  "homepage": "https://github.com/thejuu5/shelfspace#readme",
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "bcryptjs": "^3.0.3",
    "debug": "^4.4.3",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "http-errors": "^2.0.1",
    "mongodb": "^7.7.0",
    "morgan": "^1.12.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.11",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10"
  }
}
